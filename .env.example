# ---------------------------------------------------------------------------
# Firefly Studio — environment
# Copy to .env and fill in. `pnpm dev` fails fast if anything here is invalid.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Change the password before exposing anything.
DATABASE_URL=postgresql://firefly_studio:firefly_studio@localhost:5432/firefly_studio

# --- Secrets ----------------------------------------------------------------
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# WARNING: this key decrypts every stored Firefly Personal Access Token.
# Lose it and every user must re-enter their token. Back it up separately from
# your database backups — see docs and E25-04.
APP_ENCRYPTION_KEY=
# Session/JWT signing secret, also 32 random bytes base64.
AUTH_SECRET=

# --- Redis (optional; Postgres fallback is used when unset) ------------------
REDIS_URL=redis://localhost:6379

# --- Firefly III connection policy (see PROJECT_PLAN.md §4.2) ---------------
# Allow connecting to RFC1918 / loopback / link-local addresses. Self-hosted
# Firefly usually lives on a LAN, so this is `true` in the self-host image and
# MUST be `false` for any internet-facing deployment.
FIREFLY_ALLOW_PRIVATE_NETWORKS=true
# Allow plain http:// base URLs. Keep false unless you know what you are doing.
FIREFLY_ALLOW_INSECURE_HTTP=false
# Hard floor: connections to older instances are refused outright.
MIN_FIREFLY_VERSION=6.1.0
# Soft floor: below this we warn and hide unsupported features.
RECOMMENDED_FIREFLY_VERSION=6.2.0
# Per-request timeout (ms) and response size cap (bytes) for proxied calls.
FIREFLY_REQUEST_TIMEOUT_MS=10000
FIREFLY_MAX_RESPONSE_BYTES=26214400

# --- Observability (optional) -----------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=firefly-studio
