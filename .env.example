# ---------------------------------------------------------------------------
# Firefly Studio — environment
# Copy to .env and fill in. `pnpm dev` fails fast if anything here is invalid.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Change the password before exposing anything.
DATABASE_URL=postgresql://firefly_studio:firefly_studio@localhost:5432/firefly_studio

# --- Secrets ----------------------------------------------------------------
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# WARNING: this key decrypts every stored Firefly Personal Access Token.
# Lose it and every user must re-enter their token. Back it up separately from
# your database backups — see docs and E25-04.
APP_ENCRYPTION_KEY=
# Session/JWT signing secret, also 32 random bytes base64.
AUTH_SECRET=

# --- Redis (optional; Postgres fallback is used when unset) ------------------
REDIS_URL=redis://localhost:6379

# --- Firefly III connection policy (see PROJECT_PLAN.md §4.2) ---------------
# Allow connecting to RFC1918 / loopback / link-local addresses. Self-hosted
# Firefly usually lives on a LAN, so this is `true` in the self-host image and
# MUST be `false` for any internet-facing deployment.
FIREFLY_ALLOW_PRIVATE_NETWORKS=true
# Allow plain http:// base URLs. Keep false unless you know what you are doing.
FIREFLY_ALLOW_INSECURE_HTTP=false
# Hard floor: connections to older instances are refused outright.
MIN_FIREFLY_VERSION=6.1.0
# Soft floor: below this we warn and hide unsupported features.
RECOMMENDED_FIREFLY_VERSION=6.2.0
# Per-request timeout (ms) and response size cap (bytes) for proxied calls.
FIREFLY_REQUEST_TIMEOUT_MS=10000
FIREFLY_MAX_RESPONSE_BYTES=26214400

# --- Mail (E2-28) -----------------------------------------------------------
# console  print verification/reset links to the server log (the default, and
#          what makes evaluation work with no mail provider at all)
# smtp     any SMTP server, including SES
# resend   Resend's HTTP API
# A transport that is selected but unconfigured fails at boot rather than
# silently swallowing every email.
MAIL_TRANSPORT=console
MAIL_FROM=Firefly Studio <no-reply@localhost>
#MAIL_REPLY_TO=

# Either a full URL:
#SMTP_URL=smtps://user:pass@smtp.example.com:465
# …or the discrete fields. SMTP_SECURE defaults to true only on port 465.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_SECURE=false

#RESEND_API_KEY=

# --- Password policy (E2-27) ------------------------------------------------
# Check new passwords against Have I Been Pwned. Only the first 5 characters of
# the SHA-1 digest are sent (k-anonymity) — the password never leaves the
# server. Off by default: calling a third party on sign-up is your call. Fails
# open, so an HIBP outage cannot block account creation.
PASSWORD_BREACH_CHECK=false

# --- Scheduled connection health checks (E2-24) -----------------------------
# Set to enable GET /api/cron/health, for driving the check from real cron:
#   curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/health
# Unset, the endpoint 404s and the app relies on opportunistic checks made by
# the app shell when a recorded result goes stale.
#CRON_SECRET=

# --- Observability (optional) -----------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=firefly-studio
