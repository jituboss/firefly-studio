# ---------------------------------------------------------------------------
# Firefly Studio — environment
# Copy to .env and fill in. `pnpm dev` fails fast if anything here is invalid.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Change the password before exposing anything.
DATABASE_URL=postgresql://firefly_studio:firefly_studio@localhost:5432/firefly_studio

# --- Secrets ----------------------------------------------------------------
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# WARNING: this key decrypts every stored Firefly Personal Access Token.
# Lose it and every user must re-enter their token. Back it up separately from
# your database backups — see docs and E25-04.
APP_ENCRYPTION_KEY=
# Session/JWT signing secret, also 32 random bytes base64.
AUTH_SECRET=

# --- Redis (optional; Postgres fallback is used when unset) ------------------
REDIS_URL=redis://localhost:6379

# --- Firefly III connection policy (see PROJECT_PLAN.md §4.2) ---------------
# Allow connecting to RFC1918 / loopback / link-local addresses. Self-hosted
# Firefly usually lives on a LAN, so this is `true` in the self-host image and
# MUST be `false` for any internet-facing deployment.
FIREFLY_ALLOW_PRIVATE_NETWORKS=true
# Allow plain http:// base URLs. Keep false unless you know what you are doing.
FIREFLY_ALLOW_INSECURE_HTTP=false
# Hard floor: connections to older instances are refused outright.
MIN_FIREFLY_VERSION=6.1.0
# Soft floor: below this we warn and hide unsupported features.
RECOMMENDED_FIREFLY_VERSION=6.2.0
# Per-request timeout (ms) and response size cap (bytes) for proxied calls.
FIREFLY_REQUEST_TIMEOUT_MS=10000
FIREFLY_MAX_RESPONSE_BYTES=26214400

# --- Mail (E2-28) -----------------------------------------------------------
# console  print verification/reset links to the server log (the default, and
#          what makes evaluation work with no mail provider at all)
# smtp     any SMTP server, including SES
# resend   Resend's HTTP API
# A transport that is selected but unconfigured fails at boot rather than
# silently swallowing every email.
MAIL_TRANSPORT=console
MAIL_FROM=Firefly Studio <no-reply@localhost>
#MAIL_REPLY_TO=

# Either a full URL:
#SMTP_URL=smtps://user:pass@smtp.example.com:465
# …or the discrete fields. SMTP_SECURE defaults to true only on port 465.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_SECURE=false

#RESEND_API_KEY=

# --- Password policy (E2-27) ------------------------------------------------
# Check new passwords against Have I Been Pwned. Only the first 5 characters of
# the SHA-1 digest are sent (k-anonymity) — the password never leaves the
# server. Off by default: calling a third party on sign-up is your call. Fails
# open, so an HIBP outage cannot block account creation.
PASSWORD_BREACH_CHECK=false

# --- Scheduled connection health checks (E2-24) -----------------------------
# Set to enable GET /api/cron/health, for driving the check from real cron:
#   curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/health
# Unset, the endpoint 404s and the app relies on opportunistic checks made by
# the app shell when a recorded result goes stale.
#CRON_SECRET=

# --- Observability (optional) -----------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=firefly-studio

# ---------------------------------------------------------------------------
# Managed Firefly III (optional)
#
# Point this at a Firefly III instance this deployment operates. When set,
# onboarding offers it as a one-click choice: the app registers an account for
# each user on that instance and mints their access token, so nobody has to
# find a Personal Access Token by hand. Users can still connect their own
# instance instead, and can switch between the two at any time — the mapping
# between an app user and their managed Firefly account is kept permanently, so
# switching back always lands on the same ledger.
#
# REQUIREMENT: the instance must have "single user mode" turned OFF
# (Administration → Configuration), otherwise Firefly refuses registrations and
# provisioning fails with a message saying exactly that. Because that opens
# public registration on the instance, keep it on a private network or behind a
# proxy that only this app can reach.
#
# Inside docker-compose the bundled instance is http://firefly:8080.
MANAGED_FIREFLY_URL=
# Used only to preflight the instance; provisioning does not need them, because
# Firefly scopes token creation to the session of the user being provisioned.
MANAGED_FIREFLY_ADMIN_EMAIL=
MANAGED_FIREFLY_ADMIN_PASSWORD=
MANAGED_FIREFLY_LABEL=Managed Firefly III

# ---------------------------------------------------------------------------
# E2-26 — the demo account (optional)
#
# Set both and the sign-in page offers "Try the demo", signing in to a shared
# account flagged `is_demo`. That flag is what makes publishing a password
# safe: lib/demo.ts refuses connection changes, the danger zone, credential
# changes, account deletion and step-up elevation for it. Ledger writes stay
# allowed — a demo of an accounting app that cannot record a transaction
# demonstrates nothing.
#
# Provision it with:
#   FIREFLY_URL=... FIREFLY_PAT=... pnpm demo:seed     # three years of data
#   FIREFLY_URL=... FIREFLY_PAT=... pnpm demo:account  # the app-side account
# ---------------------------------------------------------------------------
DEMO_EMAIL=
DEMO_PASSWORD=

# --- Access logging (E1-16) --------------------------------------------------
# nginx-style request lines on stdout, so `docker logs` answers "who hit what".
# On by default. Each line carries ip, method, url, status, bytes, duration and
# user agent, both as a readable string and as structured fields.
#
# Query values that could be credentials are redacted before anything is
# written: /verify-email/confirm?token=... and /reset-password?token=... carry
# single-use account-takeover tokens, and stdout is the most-forwarded artefact
# a deployment produces.
#ACCESS_LOG=false            # silence it entirely
#ACCESS_LOG_STATIC=true      # include /_next/static, icons, the service worker
#ACCESS_LOG_PROBES=true      # include /api/health and /api/ready
#
# Set this ONLY when a reverse proxy (nginx, Traefik, Cloudflare, a TrueNAS app
# proxy) sits in front. It makes the app believe x-forwarded-for. With nothing
# in front, any visitor can forge that header and write whatever address they
# like into your logs — which is worse than the socket address, because the log
# then looks authoritative.
#ACCESS_LOG_TRUST_PROXY=true
