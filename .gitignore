# dependencies
node_modules/
.pnpm-store/

# next
.next/
out/
next-env.d.ts
*.tsbuildinfo

# test / coverage
coverage/
test-results/
playwright-report/

# env — never commit real secrets
.env
.env.*
!.env.example

# os / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# runtime
*.log
tmp/
dist/

# Filled-in deployment files. These carry real generated secrets — encryption
# keys, database passwords, the Firefly admin password — so they stay on the
# machine that deploys them and never in the history. `deploy/*/README.md` is
# kept so the shape of a deployment can still be documented.
deploy/**
!deploy/*/
!deploy/*/README.md
