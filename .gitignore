# dependencies
node_modules/
.pnpm-store/

# next
.next/
out/
next-env.d.ts
*.tsbuildinfo

# test / coverage
coverage/
test-results/
playwright-report/

# env — never commit real secrets
.env
.env.*
!.env.example

# os / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# runtime
*.log
tmp/
dist/

# Filled-in deployment files. These carry real generated secrets — encryption
# keys, database passwords, the Firefly admin password — so they stay on the
# machine that deploys them and never in the history.
#
# The `.example.yml` alongside them is the same stack with every secret replaced
# by a `CHANGE_ME_` placeholder, which is what gets committed. Deny-by-default
# and name the exceptions, rather than ignoring `docker-compose.yml` by name: a
# second deployment file added later is then ignored automatically instead of
# being committed by whoever did not think to update this list.
deploy/**
!deploy/*/
!deploy/*/README.md
!deploy/*/*.example.yml
