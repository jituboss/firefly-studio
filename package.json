{
  "name": "firefly-studio",
  "version": "0.11.0",
  "private": true,
  "description": "A modern front-end client for Firefly III",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "clean": "rm -rf .next coverage dist tsconfig.tsbuildinfo",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "spec:update": "tsx scripts/spec-update.ts",
    "spec:codegen": "tsx scripts/spec-codegen.ts",
    "prepare": "node scripts/install-hooks.mjs",
    "lint:fix": "eslint . --fix",
    "build:migrator": "tsx scripts/build-cli.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "docker compose down -v postgres && docker compose up -d postgres && sleep 3 && pnpm db:migrate && pnpm db:seed",
    "user:verify": "tsx scripts/verify-user.ts",
    "user:admin": "tsx scripts/user-admin.ts",
    "firefly:seed": "tsx scripts/seed-firefly.ts",
    "check:responsive": "node scripts/check-responsive.mjs",
    "release": "node scripts/release.mjs",
    "docker:build": "docker build -f docker/Dockerfile -t firefly-studio:dev .",
    "lint:workflows": "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:latest -color",
    "check:a11y": "node scripts/check-a11y.mjs",
    "audit": "pnpm audit --audit-level moderate",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:bundle:update": "rm -rf .next && pnpm build && node scripts/check-bundle.mjs --update",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:account": "tsx scripts/build-cli.ts && node dist/demo-account.cjs",
    "demo:reset": "tsx scripts/demo-seed.ts --reset && pnpm demo:account"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@node-rs/argon2": "^2.2.1",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/nextjs": "^10.75.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.47.0",
    "next": "^15.5.25",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.13.0",
    "dotenv": "^18.0.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "openapi-typescript": "^7.13.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
